generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Order {
  id            String      @id @default(cuid())
  userId        Int         @map("user_id")
  userEmail     String?     @map("user_email")
  userName      String?     @map("user_name")
  userNotes     String?     @map("user_notes")
  amount        Decimal     @db.Decimal(10, 2)
  payAmount     Decimal?    @db.Decimal(10, 2) @map("pay_amount")
  feeRate       Decimal?    @db.Decimal(5, 4)  @map("fee_rate")
  rechargeCode  String      @unique @map("recharge_code")
  status        OrderStatus @default(PENDING)
  paymentType   String      @map("payment_type")

  paymentTradeNo String?    @map("payment_trade_no")
  payUrl        String?     @map("pay_url")
  qrCode        String?     @map("qr_code")
  qrCodeImg     String?     @map("qr_code_img")

  refundAmount  Decimal?    @db.Decimal(10, 2) @map("refund_amount")
  refundReason  String?     @map("refund_reason")
  refundAt      DateTime?   @map("refund_at")
  forceRefund   Boolean     @default(false) @map("force_refund")
  refundRequestedAt DateTime? @map("refund_requested_at")
  refundRequestReason String? @map("refund_request_reason")
  refundRequestedBy Int? @map("refund_requested_by")

  expiresAt     DateTime    @map("expires_at")
  paidAt        DateTime?   @map("paid_at")
  completedAt   DateTime?   @map("completed_at")
  failedAt      DateTime?   @map("failed_at")
  failedReason  String?     @map("failed_reason")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  clientIp      String?     @map("client_ip")
  srcHost       String?     @map("src_host")
  srcUrl        String?     @map("src_url")

  // ── 订单类型 & 订阅相关 ──
  orderType           String             @default("balance") @map("order_type")
  planId              String?            @map("plan_id")
  plan                SubscriptionPlan?  @relation(fields: [planId], references: [id])
  subscriptionGroupId Int?               @map("subscription_group_id")
  subscriptionDays    Int?               @map("subscription_days")
  providerInstanceId  String?  @map("provider_instance_id")

  // ── 充值活动快照（充 X 送 Y）──
  /// 活动赠送的到账金额（USD），履约时与 amount 一起入账；退款时一并扣回。
  bonusAmount   Decimal?           @db.Decimal(10, 2) @map("bonus_amount")
  promotionId   String?            @map("promotion_id")
  promotion     RechargePromotion? @relation(fields: [promotionId], references: [id], onDelete: SetNull)
  /// 下单时的活动名称快照，活动删除后订单仍可展示。
  promotionName String?            @map("promotion_name")

  auditLogs      AuditLog[]
  invoiceRequest InvoiceRequest?
  invoiceOrder   InvoiceRequestOrder?

  @@index([userId])
  @@index([status])
  @@index([expiresAt])
  @@index([createdAt])
  @@index([paidAt])
  @@index([paymentType, paidAt])
  @@index([orderType])
  @@index([promotionId])
  @@map("orders")
}

enum OrderStatus {
  PENDING
  PAID
  RECHARGING
  COMPLETED
  EXPIRED
  CANCELLED
  FAILED
  REFUND_REQUESTED
  REFUNDING
  PARTIALLY_REFUNDED
  REFUNDED
  REFUND_FAILED
}

model AuditLog {
  id        String   @id @default(cuid())
  orderId   String   @map("order_id")
  order     Order    @relation(fields: [orderId], references: [id])
  action    String
  detail    String?  @db.Text
  operator  String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([orderId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ── 渠道展示配置 ──
model Channel {
  id             String   @id @default(cuid())
  groupId        Int?     @unique @map("group_id")
  name           String
  platform       String   @default("claude")
  rateMultiplier Decimal  @db.Decimal(10, 4) @map("rate_multiplier")
  description    String?  @db.Text
  models         String?  @db.Text
  features       String?  @db.Text
  sortOrder      Int      @default(0) @map("sort_order")
  enabled        Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([sortOrder])
  @@map("channels")
}

// ── 订阅套餐配置 ──
model SubscriptionPlan {
  id            String   @id @default(cuid())
  groupId       Int?     @map("group_id")
  name          String
  description   String?  @db.Text
  price         Decimal  @db.Decimal(10, 2)
  originalPrice Decimal? @db.Decimal(10, 2) @map("original_price")
  validityDays  Int      @default(30) @map("validity_days")
  validityUnit  String   @default("day") @map("validity_unit") // day | week | month
  features      String?  @db.Text
  productName   String?  @map("product_name")
  forSale       Boolean  @default(false) @map("for_sale")
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  orders        Order[]

  @@index([forSale, sortOrder])
  @@map("subscription_plans")
}

// ── 充值活动（充 X 送 Y，赠送直接计入余额） ──
/// 门槛按到账金额（USD）判断；多个活动同时满足时不叠加，取赠送最高者。
/// 名额按引用该活动且状态不为 CANCELLED/EXPIRED 的订单数统计（下单即占用）。
model RechargePromotion {
  id           String    @id @default(cuid())
  name         String
  description  String?   @db.Text
  minAmount    Decimal   @db.Decimal(10, 2) @map("min_amount")
  bonusType    String    @default("fixed") @map("bonus_type") // fixed | percent
  bonusValue   Decimal   @db.Decimal(10, 2) @map("bonus_value") // fixed: USD; percent: 百分比
  maxBonus     Decimal?  @db.Decimal(10, 2) @map("max_bonus") // percent 封顶，可空
  startsAt     DateTime? @map("starts_at")
  endsAt       DateTime? @map("ends_at")
  perUserLimit Int       @default(0) @map("per_user_limit") // 0 = 不限
  totalLimit   Int       @default(0) @map("total_limit") // 0 = 不限
  enabled      Boolean   @default(true)
  sortOrder    Int       @default(0) @map("sort_order")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  orders Order[]

  @@index([enabled, sortOrder])
  @@map("recharge_promotions")
}

// ── 系统配置 ──
model SystemConfig {
  key       String   @id
  value     String   @db.Text
  group     String   @default("general")
  label     String?
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([group])
  @@map("system_configs")
}

// ── 发票（增值税普通发票） ──

enum InvoiceStatus {
  PENDING
  ISSUED
  REJECTED
  CANCELLED
}

/// 一张订单最多一条开票申请（orderId 唯一）。被驳回或取消后重新申请时复用同一行
/// 改回 PENDING，而不是新插一行——这样「一单一票」由数据库约束兜底。
model InvoiceRequest {
  id String @id @default(cuid())
  /// 主订单。合并开票时取最早付款的那张，用于审计日志、通知邮件与管理端展示。
  /// 完整的覆盖订单清单在 orders 里（单订单开票也会写一行）。
  orderId String                @unique @map("order_id")
  order   Order                 @relation(fields: [orderId], references: [id])
  orders  InvoiceRequestOrder[]
  userId  Int                   @map("user_id")

  titleName    String  @map("title_name")
  taxNo        String  @map("tax_no")
  remark       String? @db.Text
  /// 仅展示给管理员；通知邮件的收件人始终由后端按 userId 解析。
  contactEmail String? @map("contact_email")

  /// 人民币开票金额，下单时对 order.payAmount 的快照。
  amount Decimal       @db.Decimal(10, 2)
  status InvoiceStatus @default(PENDING)

  fileKey         String? @map("file_key")
  fileName        String? @map("file_name")
  fileSize        Int?    @map("file_size")
  fileContentType String? @map("file_content_type")

  rejectReason String?   @map("reject_reason") @db.Text
  adminNote    String?   @map("admin_note") @db.Text
  issuedAt     DateTime? @map("issued_at")
  issuedBy     String?   @map("issued_by")
  rejectedAt   DateTime? @map("rejected_at")
  notifiedAt   DateTime? @map("notified_at")

  downloadCount    Int       @default(0) @map("download_count")
  lastDownloadedAt DateTime? @map("last_downloaded_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("invoice_requests")
}

/// 合并开票明细：一张发票覆盖的每一张订单。
///
/// order_id 上的唯一约束是「一单只进一张有效发票」的最终裁决者——并发提交时后到者
/// 拿 P2002，映射成 409。被驳回/取消的发票在重新申请时整行删除（级联清掉这里的行），
/// 所以唯一约束不会挡住重新开票。
model InvoiceRequestOrder {
  id        String         @id @default(cuid())
  invoiceId String         @map("invoice_id")
  invoice   InvoiceRequest @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  orderId   String         @unique @map("order_id")
  order     Order          @relation(fields: [orderId], references: [id])
  /// 该订单计入发票的人民币金额，申请时对 order.payAmount 的快照。
  amount    Decimal        @db.Decimal(10, 2)
  createdAt DateTime       @default(now()) @map("created_at")

  @@index([invoiceId])
  @@map("invoice_request_orders")
}

/// 抬头记忆：用户再次开票时自动回填，按税号去重。
model InvoiceTitle {
  id           String   @id @default(cuid())
  userId       Int      @map("user_id")
  titleName    String   @map("title_name")
  taxNo        String   @map("tax_no")
  remark       String?  @db.Text
  contactEmail String?  @map("contact_email")
  lastUsedAt   DateTime @default(now()) @map("last_used_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([userId, taxNo])
  @@index([userId, lastUsedAt])
  @@map("invoice_titles")
}

// ── 支付服务商实例（多实例轮询） ──
model PaymentProviderInstance {
  id             String   @id @default(cuid())
  providerKey    String   @map("provider_key") // easypay, alipay, wxpay, stripe
  name           String   // display name like "易支付A"
  config         String   @db.Text // encrypted JSON credentials
  supportedTypes String   @default("") @map("supported_types") // comma-separated: alipay,wxpay,stripe
  enabled        Boolean  @default(true)
  sortOrder      Int      @default(0) @map("sort_order")
  limits         String?  @db.Text // JSON per-channel limits: { "alipay": { "dailyLimit": 10000, "singleLimit": 1000 } }
  refundEnabled  Boolean  @default(false) @map("refund_enabled")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([providerKey])
  @@index([providerKey, enabled])
  @@map("payment_provider_instances")
}
